{
  "name": "expense-budget-tracker-website",
  "version": "0.1.0",
  "private": true,
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false,
    "sharp@0.35.4": true,
    "unrs-resolver@1.12.2": true
  },
  "description": "Marketing website for Expense Budget Tracker",
  "author": "Kirill Markin",
  "license": "MIT",
  "packageManager": "npm@11.19.1",
  "scripts": {
    "bigquery:query": "node --env-file=.env.bigquery.local --import tsx scripts/queryBigQuery.ts",
    "generate:static-content": "tsx scripts/generateStaticContent.ts",
    "predev": "npm run generate:static-content",
    "prebuild": "npm run generate:static-content",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint ."
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1"
  },
  "devDependencies": {
    "@google-cloud/bigquery": "^9.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kirill-markin/expense-budget-tracker-website"
  }
}
