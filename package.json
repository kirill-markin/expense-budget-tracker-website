{
  "name": "expense-budget-tracker-website",
  "version": "0.1.0",
  "private": true,
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false,
    "sharp@0.35.5": true,
    "unrs-resolver@1.13.0": true
  },
  "description": "Marketing website for Expense Budget Tracker",
  "author": "Kirill Markin",
  "license": "MIT",
  "packageManager": "npm@11.21.2",
  "scripts": {
    "media:check": "node scripts/checkMediaGit.ts",
    "hooks:install": "node scripts/installMediaHooks.ts",
    "bigquery:query": "node --env-file=.env.bigquery.local --import tsx scripts/queryBigQuery.ts",
    "generate:static-content": "tsx scripts/generateStaticContent.ts",
    "predev": "npm run generate:static-content",
    "prebuild": "npm run generate:static-content",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/blogEnglishSource.test.ts scripts/mediaFiles.test.ts",
    "media:add": "tsx scripts/addMedia.ts",
    "media:replace": "tsx scripts/replaceMedia.ts",
    "media:migrate": "tsx scripts/migrateMedia.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1"
  },
  "devDependencies": {
    "@google-cloud/bigquery": "^9.6.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/blob": "2.9.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.32",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^26.13.0"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "@vercel/oidc": {
      "@vercel/cli-config": "0.3.8"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kirill-markin/expense-budget-tracker-website"
  }
}
